---
title: Grupo Sazón · Delivery driver screening
---
flowchart LR
    A(["<b>Welcome</b><br/>Ask for full name"]) ==> B{"Has a driver's<br/>license?"}
    B == "Yes/doubt" ==> C{"Zone covered<br/>by the catalog?"}
    C == "One yes or doubt" ==> D["<b>Remaining profile</b><br/>Availability · Schedule<br/>Experience · Start date"]
    D ==> E{"All 7 fields<br/>resolved?"}
    E == "Yes" ==> OK["<b>Qualified</b><br/>Closed · thank and<br/>leave to the team"]
    E -- "No" --> REV["<b>Pending review</b><br/>Closed · log the doubt<br/>and flag the review"]

    B -- "Clear no" --> REJ["<b>Disqualified</b><br/>Closed · explain the reason"]
    C -- "All outside" --> REJ

    A -. "At any stage: silence<br/>(one reminder at 10 min<br/>if the chat stays open)<br/>or asks to stop" .-> INC["<b>Incomplete</b><br/>Not closed · resumes<br/>without repeating data"]

    OK ==> REC[["<b>Recruiter</b><br/>Decision: unreviewed ·<br/>advance · rejected"]]
    REV --> REC
    REJ --> REC
    INC --> REC

    classDef step fill:#e8f4fb,stroke:#2b6c94,color:#10283a,stroke-width:1.5px
    classDef bad fill:#fdecec,stroke:#b3261e,color:#5c120e,stroke-width:2px
    classDef good fill:#e6f6ec,stroke:#1e7a46,color:#0f3f24,stroke-width:2.5px
    classDef warn fill:#fff4d6,stroke:#a86a00,color:#573800,stroke-width:2px
    classDef idle fill:#eef1f5,stroke:#4a5a6a,color:#25313d,stroke-width:2px,stroke-dasharray:6 4
    classDef team fill:#ffffff,stroke:#25343c,color:#14222a,stroke-width:2px
    class A,B,C,D,E step
    class REJ bad
    class OK good
    class REV warn
    class INC idle
    class REC team
